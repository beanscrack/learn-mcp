{
  "name": "learn-mcp",
  "version": "0.1.0",
  "description": "MCP server for University of Waterloo LEARN (D2L Brightspace) and WaterlooWorks co-op portal",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "learn-mcp": "dist/index.js",
    "learn-mcp-auth": "dist/auth-cli.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "mcp",
    "d2l",
    "brightspace",
    "uwaterloo",
    "waterlooworks",
    "coop",
    "learn",
    "claude",
    "ai"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/beanscrack/learn-mcp"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc && node dist/index.js",
    "test": "vitest run",
    "start": "node dist/index.js",
    "auth": "node dist/auth-cli.js",
    "postinstall": "playwright install chromium",
    "doctor": "node dist/doctor.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.27.1",
    "better-sqlite3": "12.8.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "4.22.1",
    "mammoth": "1.12.0",
    "openai": "6.32.0",
    "pdf-parse": "1.1.1",
    "playwright": "1.58.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/pdf-parse": "^1.1.4",
    "typescript": "5.9.3",
    "vitest": "^4.1.0"
  }
}