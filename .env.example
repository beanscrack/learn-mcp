# ============================================================
# uwlearn-mcp — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# --- Required ---

# Base URL for UWaterloo LEARN (D2L Brightspace)
D2L_BASE_URL=https://learn.uwaterloo.ca

# D2L Learning Platform (LP) API version
D2L_LP_VERSION=1.57

# --- Optional (defaults shown) ---

# UWaterloo credentials — pre-fills the Shibboleth login form so you only
# need to approve the Duo MFA push. The password is never sent anywhere except
# the official UWaterloo IdP (idp.uwaterloo.ca). Leave unset to fill manually.
# D2L_USERNAME=youremail@uwaterloo.ca
# D2L_PASSWORD=yourpassword

# Directory where the Playwright browser session is cached after auth-cli login
# Default: ~/.uwlearn-session
# SESSION_DIR=~/.uwlearn-session

# Path to the local SQLite database for study tools (tasks, notes)
# Default: ~/.uwlearn-mcp/uwlearn.db
# DB_PATH=~/.uwlearn-mcp/uwlearn.db

# Local folder to scan for PDF and .docx files when running notes_sync
# NOTES_DIR=~/Documents/lecture-notes

# Port for the HTTP transport (Claude Desktop uses stdio; HTTP is for remote/API use)
# Default: 3000
# PORT=3000

# OpenAI API key — optional; only required for notes_embed_missing (semantic search)
# If not set, notes_search uses FTS5 keyword search only.
# OPENAI_API_KEY=sk-...
